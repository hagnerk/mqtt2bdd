# Production configuration for the mqtt2bdd stack.
#
# Copy this file to .env.prod and fill in the values:
#     cp .env.prod.example .env.prod
#
# .env.prod is NEVER committed — it holds a real password and is gitignored.
# This template is committed and must never contain a real credential.
#
# Every Compose command against docker-compose.prod.yml must pass it explicitly:
#     docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# =============================================================================
# Read by Docker Compose only — NOT by the application
# =============================================================================

# Image tag and the version compiled into the binary via -ldflags. Shown on the
# `starting` and `startup_complete` log lines. Default: dev
VERSION=0.1.0

# Host port published for PostgreSQL. This is the port you reach from OUTSIDE the
# stack (Grafana, psql on the host). It is NOT the port the application uses —
# see POSTGRES_PORT below. Default: 5432
POSTGRES_HOST_PORT=5432

# Host port published for the MQTT broker — the port your devices publish to.
# NOT the port the application uses; see MQTT_PORT below. Default: 1883
MQTT_HOST_PORT=1883

# =============================================================================
# Read by the application — internal/config/config.go
#
# NOTE: POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD are read by BOTH the
# application AND the postgres container (Compose interpolates them into the
# postgres service too), which is exactly why they must agree. Everything else in
# this section is read by the application only.
# =============================================================================

# --- MQTT (required) ---

# Broker hostname as seen FROM INSIDE the Docker network. Leave as the container
# name for the self-contained stack; set it to a hostname or IP to point the
# application at a broker you already run. Required, no default.
MQTT_BROKER=mqtt2bdd-prod-mosquitto

# Broker port INSIDE the Docker network. Leave at 1883 even if you changed
# MQTT_HOST_PORT — the two are different things. Required, must be an integer.
MQTT_PORT=1883

# --- MQTT (optional) ---

# Broker credentials. Leave both empty for an anonymous broker, which is what
# prod/mosquitto/mosquitto.conf configures. Default: empty.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- PostgreSQL (required) ---

# Database hostname as seen FROM INSIDE the Docker network. Leave as the container
# name for the self-contained stack; set it to a hostname or IP to point the
# application at a database you already run. Required, no default.
POSTGRES_HOST=mqtt2bdd-prod-postgres

# Database port INSIDE the Docker network. Leave at 5432 even if you changed
# POSTGRES_HOST_PORT. Required, must be an integer.
POSTGRES_PORT=5432

# Database name. Created on first startup by the postgres container.
# Required, no default.
POSTGRES_DB=mqtt2bdd

# Database user. Created on first startup and owns the sensor_metrics table.
# Required, no default.
POSTGRES_USER=mqtt2bdd

# Database password. REQUIRED — the stack refuses to start if it is unset.
# Replace the placeholder below; never commit the filled-in file.
POSTGRES_PASSWORD=<replace_with_strong_password>

# --- Application (optional) ---

# Log verbosity: DEBUG | INFO | WARN | ERROR. An unrecognised value falls back to
# INFO and is reported on the config_loaded log line. Default: INFO
LOG_LEVEL=INFO

# Capacity of the in-memory message channel between the MQTT receiver and the
# database writer. This is the outage buffer: at ~100 messages/minute, 1000 slots
# is roughly ten minutes of database downtime before messages start blocking.
# Must be an integer. Default: 1000
BUFFER_SIZE=1000

# Comma-separated MQTT topic filters whose messages are not stored, for example
#     MQTT_EXCLUDE_TOPICS=zigbee2mqtt/bridge/#
# The + and # wildcards are allowed as whole levels only, and # only as the last
# level. Surrounding spaces are trimmed and empty entries ignored. An invalid
# filter stops the application at startup (config_load_failed). The subscription
# is still #: MQTT has no negative subscription, so excluded messages still reach
# the application, which discards them. Default: empty (nothing excluded)
MQTT_EXCLUDE_TOPICS=
