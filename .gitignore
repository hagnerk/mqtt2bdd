# Environment files — never commit real credentials.
# .env.prod is the production file the README tells operators to create; .env.prod.example
# is the committed template and must stay tracked, which is why the pattern below is
# `.env.prod` and `*.env` rather than `.env.*` — the latter would swallow the template.
.env
.env.prod
*.env

# Go build artifacts
bin/
*.exe
*.test
*.out

# Go debug artifacts
__debug_bin*

# Docker temporary files
*.pid

# VS Code — track launch.json only
.vscode/*
!.vscode/launch.json

# JetBrains IDEs
.idea/
