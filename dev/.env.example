# PostgreSQL — database name created on first startup
POSTGRES_DB=mqtt2bdd

# PostgreSQL — application user (used by the app and psql verification)
POSTGRES_USER=mqtt2bdd

# PostgreSQL — password for the application user (change before deploying)
POSTGRES_PASSWORD=dev_password

# PostgreSQL — hostname inside the Docker network (matches container_name)
POSTGRES_HOST=mqtt2bdd-dev-postgres

# PostgreSQL — port exposed inside the Docker network
POSTGRES_PORT=5432

# MQTT — hostname inside the Docker network (matches container_name)
MQTT_BROKER=mqtt2bdd-dev-mosquitto

# MQTT — standard MQTT port
MQTT_PORT=1883

# MQTT — leave empty for anonymous connections (dev environment)
MQTT_USERNAME=
MQTT_PASSWORD=

# Application log verbosity: DEBUG | INFO | ERROR
LOG_LEVEL=DEBUG
